# CartStack runtime config — copy to .env and fill in.
# The .env file is gitignored. Do not commit it.
#
# Double-underscore (__) maps to the nested IConfiguration key.
# Example: Family__Code becomes IConfiguration["Family:Code"].

# Shared family login code (everyone types this on /login)
Family__Code=haus-1200

# Comma-separated family member names — seeded as Users on first run
Family__Members=David,Julian,Angelika,Andreas

<MudButton Href="@Href"
           Variant="Variant.Text"
           Class="@CssClass">
    <MudIcon Icon="@Icon" Size="Size.Large" />
    <MudText Typo="Typo.body2" Class="mt-1">@Label</MudText>
</MudButton>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? CurrentUri { get; set; }

    private bool IsActive
    {
        get
        {
            if (string.IsNullOrEmpty(CurrentUri)) return false;
            if (Href == "/") return CurrentUri == "/";
            return CurrentUri == Href || CurrentUri.StartsWith(Href + "/");
        }
    }

    private string CssClass => IsActive ? "cs-bottom-nav-item active" : "cs-bottom-nav-item";
}

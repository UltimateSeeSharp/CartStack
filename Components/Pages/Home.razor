@page "/"
@implements IDisposable
@inject IGroceryService Grocery
@inject ChangeBroadcaster Broadcaster
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>CartStack — Liste</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">

    @if (_favorites.Count > 0)
    {
        <MudPaper Class="pa-2 mb-4 d-flex" Elevation="0" Style="overflow-x:auto; gap:8px;">
            @foreach (var fav in _favorites)
            {
                var isPending = _pendingNames.Contains(fav.Name);
                <MudChip T="int"
                         Value="@fav.Id"
                         Color="@(isPending ? Color.Default : Color.Primary)"
                         Variant="@(isPending ? Variant.Outlined : Variant.Filled)"
                         Disabled="@isPending"
                         OnClick="@(() => QuickAddAsync(fav))">
                    @fav.Name
                </MudChip>
            }
        </MudPaper>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_items.Count == 0)
    {
        <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0">
            <MudIcon Icon="@Icons.Material.Outlined.ShoppingBasket" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body1" Class="mt-2">Nichts auf der Liste.</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">Tipp auf + um etwas hinzuzufügen.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTabs Elevation="0"
                 Rounded="false"
                 ActivePanelIndex="_activeTab"
                 ActivePanelIndexChanged="OnTabChangedAsync"
                 Class="mb-2">
            <MudTabPanel Text="Alle">
                <MudPaper Elevation="0">
                    <MudList T="GroceryItem">
                        @foreach (var item in _items)
                        {
                            @RenderItemRow(item, showLocation: true)
                        }
                    </MudList>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Nach Kategorie">
                @foreach (var group in _groupedByCategory)
                {
                    <MudText Typo="Typo.overline" Class="mt-4 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (group.Category is not null)
                            {
                                <MudIcon Icon="@IconHelper.ForCategoryKey(group.Category.IconKey)" Size="Size.Small" />
                            }
                            <span>@group.Label</span>
                        </MudStack>
                    </MudText>
                    <MudPaper Elevation="0" Class="mb-2">
                        @if (group.LooseItems.Count > 0)
                        {
                            <MudList T="GroceryItem">
                                @foreach (var item in group.LooseItems)
                                {
                                    @RenderItemRow(item, showLocation: false)
                                }
                            </MudList>
                        }
                        @foreach (var sub in group.StoreSubGroups)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-3 pt-2" Spacing="2">
                                <StoreLogo LogoSlug="@sub.Store.LogoSlug" StoreName="@sub.Store.Name" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Default">@sub.Store.Name</MudText>
                            </MudStack>
                            <MudList T="GroceryItem">
                                @foreach (var item in sub.Items)
                                {
                                    @RenderItemRow(item, showLocation: false)
                                }
                            </MudList>
                        }
                    </MudPaper>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<MudFab Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add"
        Class="cs-fab"
        OnClick="OpenAddDialog" />

@code {
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private bool _loading = true;
    private bool _restoredTab;
    private int _activeTab;
    private List<GroceryItem> _items = new();
    private List<CategoryGroup> _groupedByCategory = new();
    private List<Favorite> _favorites = new();
    private HashSet<string> _pendingNames = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Broadcaster.Changed += OnChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_restoredTab)
        {
            _restoredTab = true;
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "cs.liste.tab");
                if (int.TryParse(stored, out var idx) && idx is >= 0 and <= 1 && idx != _activeTab)
                {
                    _activeTab = idx;
                    StateHasChanged();
                }
            }
            catch { /* SSR or no JS, ignore */ }
        }
    }

    private async Task OnTabChangedAsync(int idx)
    {
        _activeTab = idx;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "cs.liste.tab", idx.ToString()); }
        catch { /* ignore */ }
    }

    private async Task LoadAsync()
    {
        _items = (await Grocery.GetPendingItemsAsync()).ToList();
        _groupedByCategory = BuildCategoryGroups(_items);
        _pendingNames = new HashSet<string>(_items.Select(i => i.Name), StringComparer.OrdinalIgnoreCase);
        _favorites = (await Grocery.GetFavoritesAsync()).ToList();
        _loading = false;
        StateHasChanged();
    }

    private static List<CategoryGroup> BuildCategoryGroups(IReadOnlyList<GroceryItem> items)
    {
        var groups = items
            .GroupBy(i => i.Store?.Category ?? i.Category)
            .Select(g =>
            {
                var category = g.Key;
                var withStore = g.Where(i => i.Store is not null)
                    .GroupBy(i => i.Store!)
                    .Select(sg => new StoreSubGroup(sg.Key, sg.OrderBy(i => i.AddedAt).ToList()))
                    .OrderBy(sg => sg.Store.SortOrder)
                    .ThenBy(sg => sg.Store.Name)
                    .ToList();
                var loose = g.Where(i => i.Store is null).OrderBy(i => i.AddedAt).ToList();
                return new CategoryGroup(
                    category,
                    category?.Name ?? "Ohne Kategorie",
                    loose,
                    withStore,
                    category?.SortOrder ?? int.MaxValue);
            })
            .OrderBy(g => g.SortOrder)
            .ThenBy(g => g.Label)
            .ToList();
        return groups;
    }

    private RenderFragment RenderItemRow(GroceryItem item, bool showLocation) => __builder =>
    {
        <MudListItem T="GroceryItem" Value="@item">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudCheckBox T="bool"
                             Value="false"
                             ValueChanged="@(_ => MarkBoughtAsync(item.Id))"
                             Size="Size.Large"
                             Color="Color.Primary" />
                @{
                    var effectiveCategory = item.Store?.Category ?? item.Category;
                }
                @if (showLocation && (effectiveCategory is not null || item.Store is not null))
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="min-width:0;">
                        @if (effectiveCategory is not null)
                        {
                            <MudIcon Icon="@IconHelper.ForCategoryKey(effectiveCategory.IconKey)" Size="Size.Small" />
                        }
                        @if (item.Store is not null)
                        {
                            <StoreLogo LogoSlug="@item.Store.LogoSlug" StoreName="@item.Store.Name" Size="Size.Small" />
                        }
                    </MudStack>
                }
                <MudStack Spacing="0" Class="flex-grow-1">
                    <MudText Typo="Typo.body1">
                        @item.Name
                        @if (item.Qty > 1)
                        {
                            <MudText HtmlTag="span" Typo="Typo.body2" Color="Color.Default" Class="ml-1">× @item.Qty</MudText>
                        }
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        von @(item.AddedByUser?.Name ?? "?")
                    </MudText>
                </MudStack>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               Size="Size.Small"
                               Color="Color.Default"
                               OnClick="@(() => DeleteAsync(item.Id))" />
            </MudStack>
        </MudListItem>
    };

    private async Task QuickAddAsync(Favorite fav)
    {
        if (_pendingNames.Contains(fav.Name)) return;
        try
        {
            await Grocery.AddItemAsync(fav.Name, 1, fav.DefaultCategoryId, fav.DefaultStoreId);
            Snackbar.Add($"{fav.Name} hinzugefügt", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async void OnChanged(ChangeEvent e)
    {
        if (e.Kind is ChangeKind.ItemAdded
            or ChangeKind.ItemBought
            or ChangeKind.ItemUnbought
            or ChangeKind.ItemDeleted
            or ChangeKind.StoreChanged
            or ChangeKind.FavoriteChanged)
        {
            await InvokeAsync(LoadAsync);
        }
    }

    private async Task OpenAddDialog()
    {
        var dialog = await DialogService.ShowAsync<Components.Dialogs.AddItemDialog>("Hinzufügen", new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
        });
        await dialog.Result;
    }

    private async Task MarkBoughtAsync(int id) => await Grocery.MarkBoughtAsync(id);
    private async Task DeleteAsync(int id) => await Grocery.DeleteItemAsync(id);

    public void Dispose()
    {
        Broadcaster.Changed -= OnChanged;
    }

    private record CategoryGroup(Category? Category, string Label, List<GroceryItem> LooseItems, List<StoreSubGroup> StoreSubGroups, int SortOrder);
    private record StoreSubGroup(Store Store, List<GroceryItem> Items);
}

@page "/geschaefte"
@implements IDisposable
@inject IGroceryService Grocery
@inject ChangeBroadcaster Broadcaster
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>CartStack — Geschäfte</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Geschäfte</MudText>

    @if (_categories.Count == 0)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        foreach (var category in _categories)
        {
            var stores = _storesByCategory.TryGetValue(category.Id, out var list) ? list : new List<Store>();
            <MudPaper Elevation="0" Class="mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-1 py-2">
                    <MudIcon Icon="@IconHelper.ForCategoryKey(category.IconKey)" Size="Size.Medium" />
                    <MudText Typo="Typo.h6" Class="flex-grow-1">@category.Name</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => AddStoreAsync(category))" />
                </MudStack>

                @if (stores.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="px-3 pb-2">
                        Noch keine Geschäfte.
                    </MudText>
                }
                else
                {
                    <MudList T="Store">
                        @for (var i = 0; i < stores.Count; i++)
                        {
                            var idx = i;
                            var store = stores[idx];
                            <MudListItem T="Store" Value="@store">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                   Size="Size.Small"
                                                   Disabled="@(idx == 0)"
                                                   OnClick="@(() => MoveAsync(category.Id, idx, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                   Size="Size.Small"
                                                   Disabled="@(idx == stores.Count - 1)"
                                                   OnClick="@(() => MoveAsync(category.Id, idx, 1))" />
                                    <StoreLogo LogoSlug="@store.LogoSlug" StoreName="@store.Name" Size="Size.Small" />
                                    <MudText Typo="Typo.body1" Class="flex-grow-1">@store.Name</MudText>
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RenameAsync(store))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteAsync(store))" />
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<Category> _categories = new();
    private Dictionary<int, List<Store>> _storesByCategory = new();

    protected override async Task OnInitializedAsync()
    {
        Broadcaster.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _categories = (await Grocery.GetCategoriesAsync()).ToList();
        var all = await Grocery.GetStoresAsync();
        _storesByCategory = all
            .GroupBy(s => s.CategoryId)
            .ToDictionary(g => g.Key, g => g.OrderBy(s => s.SortOrder).ThenBy(s => s.Name).ToList());
        StateHasChanged();
    }

    private async Task AddStoreAsync(Category category)
    {
        var name = await PromptAsync($"Neues Geschäft in {category.Name}", "Name");
        if (string.IsNullOrWhiteSpace(name)) return;
        try
        {
            await Grocery.AddStoreAsync(name, category.Id);
            Snackbar.Add($"{name} hinzugefügt", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RenameAsync(Store store)
    {
        var name = await PromptAsync("Umbenennen", "Name", store.Name);
        if (string.IsNullOrWhiteSpace(name) || name == store.Name) return;
        try
        {
            await Grocery.RenameStoreAsync(store.Id, name);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(Store store)
    {
        var ok = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Löschen?",
            Message = $"„{store.Name}\" wirklich löschen?",
            YesText = "Löschen",
            CancelText = "Abbrechen",
        });
        if (ok != true) return;
        try
        {
            await Grocery.DeleteStoreAsync(store.Id);
            Snackbar.Add($"{store.Name} gelöscht", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MoveAsync(int categoryId, int idx, int direction)
    {
        if (!_storesByCategory.TryGetValue(categoryId, out var stores)) return;
        var target = idx + direction;
        if (target < 0 || target >= stores.Count) return;
        (stores[idx], stores[target]) = (stores[target], stores[idx]);
        await Grocery.ReorderStoresAsync(stores.Select(s => s.Id).ToList());
    }

    private async Task<string?> PromptAsync(string title, string label, string initial = "")
    {
        var parameters = new DialogParameters<TextPromptDialog>
        {
            { x => x.Label, label },
            { x => x.Initial, initial },
        };
        var dialog = await DialogService.ShowAsync<TextPromptDialog>(title, parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
        });
        var result = await dialog.Result;
        return result?.Canceled == false ? result.Data as string : null;
    }

    private async void OnChanged(ChangeEvent e)
    {
        if (e.Kind == ChangeKind.StoreChanged)
        {
            await InvokeAsync(LoadAsync);
        }
    }

    public void Dispose() => Broadcaster.Changed -= OnChanged;
}

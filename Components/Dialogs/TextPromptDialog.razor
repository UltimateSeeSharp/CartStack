<MudDialog>
    <DialogContent>
        <MudTextField T="string"
                      @bind-Value="_value"
                      Label="@Label"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      AutoFocus="true"
                      OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(string.IsNullOrWhiteSpace(_value))"
                   OnClick="Ok">
            OK
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Initial { get; set; } = "";

    private string _value = "";

    protected override void OnInitialized() => _value = Initial;

    private void Ok()
    {
        if (string.IsNullOrWhiteSpace(_value)) return;
        Dialog.Close(DialogResult.Ok(_value.Trim()));
    }

    private void Cancel() => Dialog.Cancel();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Ok();
    }
}

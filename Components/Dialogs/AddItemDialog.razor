@inject IGroceryService Grocery
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div class="flex-grow-1">
                    <MudAutocomplete T="string"
                                     @bind-Value="_name"
                                     Label="Was?"
                                     Variant="Variant.Outlined"
                                     SearchFunc="SearchNamesAsync"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="false"
                                     MaxItems="5"
                                     DebounceInterval="120"
                                     ShowProgressIndicator="false"
                                     OpenOnFocus="false"
                                     AutoFocus="true" />
                </div>
                <MudTooltip Text="Bald verfügbar">
                    <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner"
                                   Color="Color.Default"
                                   Disabled="true" />
                </MudTooltip>
            </MudStack>

            <MudNumericField T="int"
                             @bind-Value="_qty"
                             Label="Menge"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="99" />

            <MudSelect T="int?"
                       Value="_categoryId"
                       ValueChanged="OnCategoryChanged"
                       Label="Kategorie"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var c in _categories)
                {
                    <MudSelectItem T="int?" Value="@((int?)c.Id)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@IconHelper.ForCategoryKey(c.IconKey)" Size="Size.Small" />
                            <span>@c.Name</span>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>

            @if (_categoryStores.Count > 0)
            {
                <MudSelect T="int?"
                           @bind-Value="_storeId"
                           Label="Geschäft"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (var s in _categoryStores)
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <StoreLogo LogoSlug="@s.LogoSlug" StoreName="@s.Name" Size="Size.Small" />
                                <span>@s.Name</span>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanSubmit || _submitting)"
                   OnClick="SubmitAsync">
            Hinzufügen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public int? PrefillCategoryId { get; set; }
    [Parameter] public int? PrefillStoreId { get; set; }

    private string _name = "";
    private int _qty = 1;
    private int? _categoryId;
    private int? _storeId;
    private IReadOnlyList<Category> _categories = [];
    private IReadOnlyList<Store> _allStores = [];
    private IReadOnlyList<Store> _categoryStores = [];
    private bool _submitting;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_name);

    protected override async Task OnInitializedAsync()
    {
        _categories = await Grocery.GetCategoriesAsync();
        _allStores = await Grocery.GetStoresAsync();

        if (PrefillStoreId is int sid)
        {
            var store = _allStores.FirstOrDefault(s => s.Id == sid);
            if (store is not null)
            {
                _categoryId = store.CategoryId;
                _storeId = sid;
            }
        }
        else if (PrefillCategoryId is int cid)
        {
            _categoryId = cid;
        }

        RefreshCategoryStores();
    }

    private void OnCategoryChanged(int? value)
    {
        _categoryId = value;
        _storeId = null;
        RefreshCategoryStores();
    }

    private void RefreshCategoryStores()
    {
        _categoryStores = _categoryId is int cid
            ? _allStores.Where(s => s.CategoryId == cid).ToList()
            : [];
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _submitting) return;
        _submitting = true;
        try
        {
            var item = await Grocery.AddItemAsync(_name, _qty, _categoryId, _storeId);
            Snackbar.Add($"{item.Name} hinzugefügt", Severity.Success);
            Dialog.Close(DialogResult.Ok(item.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private async Task<IEnumerable<string>> SearchNamesAsync(string? prefix, CancellationToken ct)
    {
        return await Grocery.GetNameSuggestionsAsync(prefix ?? "", 5, ct);
    }
}
